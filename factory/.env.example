# factory/.env — local runs only. In Colab these go in the secrets panel.
# Never commit the filled-in version.

GEMINI_API_KEY=
# Vision model for page transcription.
GEMINI_MODEL=
# Must return 768 dimensions to match textbook_chunks.embedding vector(768).
GEMINI_EMBED_MODEL=

# Supabase → Project settings → Database → Connection string (direct).
SUPABASE_DB_URL=
