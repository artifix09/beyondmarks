# Copy to backend/.env and paste the real values. .env is gitignored — keep it
# that way. Shared values live in the team vault, never in the group chat.

# Supabase — Project settings → API, and → API → JWT Settings for the secret
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Gemini — paid key only. Free-tier content can be used by Google to improve
# its products, and our users are minors.
GEMINI_API_KEY=
# Model names differ per key and change between releases; check Google AI
# Studio for what this key can actually call.
GEMINI_MODEL=
# Must produce 768 dimensions to match textbook_chunks.embedding vector(768).
GEMINI_EMBED_MODEL=

# Hard ceiling on a day's AI spend. The wrapper refuses further calls above it.
DAILY_AI_BUDGET_USD=2.0

# Comma separated. Add the Vercel URL when the frontend deploys.
CORS_ORIGINS=http://localhost:5173
